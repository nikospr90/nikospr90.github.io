@code {
    private async Task ScrollTo(string id)
    {
        await JS.InvokeVoidAsync("window.scrollToSection", id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.initFadeObserver");
        }
    }
}
